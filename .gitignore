# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.pytest_cache/
*.egg-info/

# LaTeX build artifacts (regenerable)
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
paper/main.pdf

# Per-cell sweep artifacts (regenerable; only *_summary.json + figures tracked)
results/st2/meter_boundary_raw/
results/st2/.meter_boundary.lock
# --smoke plumbing check writes here — never tracked
results/st2/meter_boundary_smoke_raw/
results/st2/meter_boundary_smoke_summary.json
results/st2/.meter_boundary_smoke.lock
# Slurm logs are regenerable; keep the dir itself so #SBATCH --output resolves
# at submit time on a fresh clone.
results/st2/slurm/*
!results/st2/slurm/.gitkeep

# Rung-2 sweep (Phase 2): same convention — only rung2_summary.json + figures tracked.
results/rung2/rung2_raw/
results/rung2/.rung2.lock
results/rung2/rung2_smoke_raw/
results/rung2/rung2_smoke_summary.json
results/rung2/.rung2_smoke.lock
results/rung2/slurm/*
!results/rung2/slurm/.gitkeep
