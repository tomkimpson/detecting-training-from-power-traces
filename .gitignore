# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.pytest_cache/
*.egg-info/

# LaTeX build artifacts (regenerable)
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
# paper/main.pdf is deliberately TRACKED (not ignored): the compiled manuscript is
# the artefact collaborators actually read, and for most of this project's life no
# dev node had a TeX toolchain, so a committed PDF is the only way to see the paper
# without one. Rebuild with the byte-reproducible command in README ("Build the paper")
# and commit the result alongside the source that produced it.

# Per-cell sweep artifacts (regenerable; only *_summary.json + figures tracked)
results/st1/raw/
results/st1/.far_summary.lock
results/st2/meter_boundary_raw/
results/st2/.meter_boundary.lock
# --smoke plumbing check writes here — never tracked
results/st2/meter_boundary_smoke_raw/
results/st2/meter_boundary_smoke_summary.json
results/st2/.meter_boundary_smoke.lock
# Slurm logs are regenerable; keep the dir itself so #SBATCH --output resolves
# at submit time on a fresh clone.
results/st1/slurm/*
!results/st1/slurm/.gitkeep
results/st2/slurm/*
!results/st2/slurm/.gitkeep

# Rung-2 sweep (Phase 2): same convention — only rung2_summary.json + figures tracked.
results/rung2/rung2_raw/
results/rung2/.rung2.lock
results/rung2/rung2_smoke_raw/
results/rung2/rung2_smoke_summary.json
results/rung2/.rung2_smoke.lock
results/rung2/slurm/*

# NP-optimal LRT ceiling (Phase 2): only np_ceiling_summary.json + figure tracked;
# the --smoke plumbing check (summary + figure) and slurm logs are never tracked.
results/st1/np_ceiling_smoke_summary.json
figures/st1_np_ceiling_smoke.*
results/st1/slurm/*
!results/st1/slurm/.gitkeep
!results/rung2/slurm/.gitkeep

# Pre-merge review artefacts (transient; findings belong in notes/results/)
PR_REVIEW_*.md
