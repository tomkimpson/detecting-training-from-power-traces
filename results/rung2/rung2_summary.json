{
  "sweep": "rung2",
  "generator": "ko_workload training vs hard inference null (plan \u00a73.3)",
  "n_each": 200,
  "target_fars": [
    0.05,
    0.01
  ],
  "seed": 0,
  "n_folds": 5,
  "duration_s": 300.0,
  "band": [
    0.3,
    1.7
  ],
  "rules": [
    "physics_score",
    "fitted_discriminant",
    "learned_reference"
  ],
  "transfer_shifts": [
    "f_peak_lo",
    "f_peak_hi",
    "duration_short",
    "band_shift_hi",
    "meter_controller",
    "meter_coloured"
  ],
  "controls": [
    "discarded_update_decoy",
    "gradient_only",
    "nonml_kernel_loop",
    "controller_cycle",
    "periodic_inference",
    "async_training",
    "coresident_mixture"
  ],
  "environment": "canonical: MATS `compute` partition, single-threaded OpenBLAS. Marginal AUCs are BLAS-build-conditional; the qualitative verdicts (decoy scores as training; async training missed by the physics rule) are not.",
  "cells": [
    {
      "kind": "control",
      "condition": "async_training",
      "is_training": true,
      "expect": "not_train",
      "note": "genuine training strongly de-periodicised (scoped-out edge)",
      "rules": {
        "physics_score": {
          "auc": 0.88875,
          "frac_training": {
            "0.05": 0.72,
            "0.01": 0.585
          }
        },
        "fitted_discriminant": {
          "auc": 0.754825,
          "frac_training": {
            "0.05": 0.545,
            "0.01": 0.465
          }
        },
        "learned_reference": {
          "auc": 1.0,
          "frac_training": {
            "0.05": 1.0,
            "0.01": 1.0
          }
        }
      },
      "cell": "control__async_training"
    },
    {
